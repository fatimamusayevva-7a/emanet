# Lokal/VPS yerləşdirmə üçün. AWS-də bu faylı user_data avtomatik yaradır.
EMANET_ENV=production
EMANET_PUBLIC_ORIGIN=https://emanet.example.az
EMANET_COOKIE_SECURE=true
EMANET_TRUST_PROXY=true
EMANET_DEMO_MODE=0
EMANET_KMS_BACKEND=aws
EMANET_AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:111111111111:key/...
EMANET_STORAGE_BACKEND=s3
EMANET_S3_BUCKET=emanet-prod-vaults-...
EMANET_NOTIFIER=ses
EMANET_SES_SENDER=noreply@example.az
EMANET_SECRETS_ID=arn:aws:secretsmanager:eu-central-1:111111111111:secret:emanet-prod/app
EMANET_BOOTSTRAP_OPERATOR_EMAIL=siz@example.az
AWS_REGION=eu-central-1
DOMAIN=emanet.example.az
ACME_EMAIL=siz@example.az

# --- Komissiya qarşısında DEMO üçün (istehsal DEYİL):
# EMANET_ENV=development
# EMANET_DEMO_MODE=1
# EMANET_KMS_BACKEND=local
# EMANET_STORAGE_BACKEND=local
# EMANET_NOTIFIER=outbox
