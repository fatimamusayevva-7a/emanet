# cp terraform.tfvars.example terraform.tfvars  (bu fayl .gitignore-dadır)
region       = "eu-central-1"
environment  = "prod"
acme_email   = "siz@example.az"
alert_email  = "siz@example.az"
ses_sender   = "siz@example.az"
