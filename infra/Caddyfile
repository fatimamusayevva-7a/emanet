{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	# TLS 1.2+ (Caddy defolt olaraq 1.3-ə üstünlük verir), avtomatik Let's Encrypt + yeniləmə
	tls {
		protocols tls1.2 tls1.3
	}
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}
	# Tətbiq öz CSP/CSRF başlıqlarını özü qoyur; /internal yalnız imzalı planlaşdırıcı üçündür
	reverse_proxy {$UPSTREAM:app:8000} {
		header_up X-Forwarded-For {remote_host}
	}
	log {
		output stdout
		format json
	}
}
